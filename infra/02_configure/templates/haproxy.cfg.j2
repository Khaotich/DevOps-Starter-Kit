global
    log /dev/log {{ dns_domain }}0
    maxconn 2000

defaults
    log global
    mode tcp
    option tcplog

    timeout connect 5s
    timeout client 8h
    timeout server 8h

frontend shared_http_in
    mode http
    bind {{ ip }}:80

    use_backend sso_cluster if { hdr(host) -i {{ sso.hostname }}.{{ dns_prefix }}.{{ dns_domain }} }
    use_backend vault_cluster if { hdr(host) -i {{ vault.hostname }}.{{ dns_prefix }}.{{ dns_domain }} }


# --- Backend: Sso ---
backend sso_cluster
    mode http
    balance roundrobin
    server sso_node1 {{ sso.ip }}:{{ sso.keycloak_port }} check

# --- Backend: Vault ---
backend vault_cluster
    mode http
    balance roundrobin
    server vault_node1 {{ vault.ip }}:{{ vault.vault_port }} check
